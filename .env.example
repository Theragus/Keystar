# ---------------------------------------------------------------------------
# Keystar configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# Public hostname Caddy serves and gets a TLS certificate for (DNS must point here).
KEYSTAR_DOMAIN=keystar.example.com
# Public URL of the app, no trailing slash. Must match the EVE application callback.
APP_URL=https://keystar.example.com

# Generate with: openssl rand -base64 48
# Encrypts stored ESI refresh tokens — keep it safe and never change it after
# characters are linked (tokens become unreadable and must be re-authorised).
APP_SECRET=

# Postgres password used by docker compose (DATABASE_URL is built from it).
POSTGRES_PASSWORD=
# Only needed outside docker compose (e.g. `pnpm dev`):
# DATABASE_URL=postgres://keystar:keystar@localhost:5432/keystar

# EVE application from https://developers.eveonline.com/applications
#   Callback URL: ${APP_URL}/auth/callback
#   Scopes: enable every scope listed in docs/deployment.md
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Contact info sent to CCP in the ESI User-Agent (email or EVE character name).
ESI_CONTACT=

# Optional: comma separated character IDs that are always admins. If empty,
# the first person to sign in becomes admin — sign in right after deploying.
ADMIN_CHARACTER_IDS=

# Optional tuning
# ESI_COMPATIBILITY_DATE=2026-08-18
# WORKER_CONCURRENCY=4
# LOG_LEVEL=info

# Demo mode: seeds no data by itself, but allows signing in as seeded demo users
# without EVE SSO. NEVER enable on a public instance with real data.
KEYSTAR_DEMO_MODE=false
